rules_version = '2';

// The mobile app never talks to Firestore directly: every read and write goes
// through the BFF with the Admin SDK (which bypasses these rules). Denying
// client access closes the door on anyone using the public Firebase config
// to read or tamper with balances.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
