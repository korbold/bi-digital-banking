# Service account JSON de Firebase codificado en base64:
#   base64 -i service-account.json | tr -d '\n'
# Consola Firebase > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada.
# NUNCA commitear el JSON ni este valor.
FIREBASE_SERVICE_ACCOUNT=

# URL pública del BFF (para armar URLs de micro-apps en el SDUI). Opcional:
# si falta se usa el origin de la request.
PUBLIC_BASE_URL=https://bi-digital-banking.vercel.app

# Proveedor de tipos de cambio (opcional, default open.er-api.com)
FX_API_URL=https://open.er-api.com/v6/latest
